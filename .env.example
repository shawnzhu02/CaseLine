# CaseLine configuration. Copy to .env and fill in locally; NEVER commit .env.
# Names are CaseLine conventions validated in apps/api/caseline/config.py and apps/voice/caseline_voice/settings.py.

APP_ENV=development
API_PUBLIC_BASE_URL=http://localhost:8000
# Local Postgres from compose.yaml. For a zero-dependency run use: sqlite:///./caseline-dev.db
DATABASE_URL=postgresql+psycopg://caseline:caseline_dev_only@localhost:5432/caseline

# --- Telecom: Guava is the ONLY phone/SMS provider. ---
TELECOM_PROVIDER=guava
# mock = in-memory fake gateways; live = real Guava SMS from the outbox worker (requires GUAVA_API_KEY)
GUAVA_MODE=mock
GUAVA_API_KEY=
# The Guava-managed CaseLine inbound number callers dial.
GUAVA_AGENT_NUMBER=+14849687497
GUAVA_SMS_ENABLED=false
# Must be an SMS-capable Guava number (SMS capability of +14849687497 is NOT yet verified).
GUAVA_SMS_FROM_NUMBER=

# Shared bearer token between the voice agent and the API. Use a long random value outside development.
CASELINE_INTERNAL_API_TOKEN=dev-only-token

# --- Email (separate from telephony) ---
EMAIL_PROVIDER=mock
RESEND_API_KEY=
EMAIL_FROM=

# --- Demo (spec section 4A). Live outbound transfer defaults OFF. ---
DEMO_MODE=false
DEMO_LIVE_TRANSFER_ENABLED=false
DEMO_FIRM_A_NAME=Demo Partner Firm A
DEMO_FIRM_A_TRANSFER_NUMBER=+12676804795
DEMO_FIRM_B_NAME=Demo Partner Firm B
DEMO_FIRM_B_TRANSFER_NUMBER=+16173187562
DEMO_TRANSFER_ALLOWLIST=+12676804795,+16173187562
DEMO_SIMULATE_FIRM_AVAILABILITY=false

# --- Voice agent (apps/voice) ---
CASELINE_API_BASE_URL=http://127.0.0.1:8000
VOICE_TRANSFER_ALLOWLIST=+12676804795,+16173187562

# --- Tuning ---
TRANSFER_AUTHORIZATION_TTL_SECONDS=120
NOTIFICATION_MAX_RETRIES=5
NOTIFICATION_BACKOFF_BASE_SECONDS=30
REFERRAL_EXPIRY_HOURS=72

# --- Phase 3 (not implemented yet): private report storage ---
STORAGE_BUCKET=
STORAGE_REGION=
REPORT_LINK_TTL_MINUTES=30
